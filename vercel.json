    { "source": "/login", "destination": "/auth/aavirafashion", "permanent": true },
    { "source": "/auth/aavirafashion/", "destination": "/auth/aavirafashion", "permanent": true },
    { "source": "/profile.html", "destination": "/profile", "permanent": true },
    { "source": "/product.html", "destination": "/product", "permanent": true },
    { "source": "/cart.html", "destination": "/cart", "permanent": true },
    { "source": "/checkout.html", "destination": "/checkout", "permanent": true },
    { "source": "/categories.html", "destination": "/categories", "permanent": true },
    { "source": "/orders.html", "destination": "/orders", "permanent": true },
    { "source": "/offer.html", "destination": "/offer", "permanent": true },
    { "source": "/support.html", "destination": "/support", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/wishlist.html", "destination": "/wishlist", "permanent": true }
